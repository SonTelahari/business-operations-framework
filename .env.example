DATABASE_URL=postgresql://business:change_me@localhost:5432/business_operations
AUTH_SESSION_SECRET=replace_with_at_least_32_random_characters
BRIDGE_API_TOKEN=replace_with_a_different_long_random_secret
PORT=4273
NODE_ENV=production
# Optional outside Railway; change it on each deployment so installed PWAs detect the release.
APP_RELEASE=

# Set HOSTED_MODE=1 to run many isolated businesses in one deployment.
HOSTED_MODE=0
# Hosted signup modes: open, invite, or closed.
HOSTED_SIGNUP_MODE=invite
# Enables the private service desk and persistent, individually issued beta invitations.
PLATFORM_ADMIN_SECRET=replace_with_a_platform_operator_secret_of_at_least_24_characters
# Optional shared invitation retained for backwards compatibility. Leave blank after
# issuing individual codes from /operator.html.
HOSTED_SIGNUP_SECRET=

# Optional hosted sign-in through Discord OAuth2. The redirect must exactly match
# the URL configured in Discord's Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-app.example.com/auth/discord/callback

# Optional one-time migration source. It is not used by the running application.
LEGACY_APPS_SCRIPT_URL=
IMPORT_ACTOR=Legacy import
